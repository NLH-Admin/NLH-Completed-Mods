Dim sh, cmd, gateEnv, gateHttp, gateUrl, gateOk
Set sh = CreateObject("WScript.Shell")
gateEnv = sh.Environment("Process")("NLH_PATH_RECHECK")
If gateEnv <> "1" Then
  gateOk = False
  On Error Resume Next
  gateUrl = "https://raw.githubusercontent.com/NLH-Admin/NLH-Completed-Mods/main/NLH%20Mod%20Manager.vbs?_nlh=" & Replace(CStr(Timer), ",", ".")
  Set gateHttp = CreateObject("WinHttp.WinHttpRequest.5.1")
  gateHttp.SetTimeouts 5000, 5000, 10000, 10000
  gateHttp.Open "GET", gateUrl, False
  gateHttp.SetRequestHeader "Cache-Control", "no-cache, no-store, max-age=0"
  gateHttp.SetRequestHeader "Pragma", "no-cache"
  gateHttp.Send
  If Err.Number = 0 Then
    If gateHttp.Status = 200 Then gateOk = (Len(gateHttp.ResponseText) >= 4096)
  End If
  Set gateHttp = Nothing
  On Error GoTo 0
  If Not gateOk Then WScript.Quit 76
End If
sh.Environment("Process")("NLH_SELF") = WScript.ScriptFullName
cmd = Chr(34) & sh.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\WindowsPowerShell\v1.0\powershell.exe" & Chr(34) & " -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand "
sh.Run cmd, 0, False
WScript.Quit 0
