Option Explicit
Dim shell, powerShellPath, commandLine
Set shell = CreateObject("WScript.Shell")
powerShellPath = shell.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\WindowsPowerShell\v1.0\powershell.exe"
shell.Environment("Process")("NLH_SELF") = WScript.ScriptFullName
commandLine = Chr(34) & powerShellPath & Chr(34) & " -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand "
shell.Run commandLine, 0, True
WScript.Quit 0
