Option Explicit
Dim sh,fs,f,ln,data,dom,node,stm,gz,tmp,cmd,rc
Set sh=CreateObject("WScript.Shell")
Set fs=CreateObject("Scripting.FileSystemObject")
data=""
Set f=fs.OpenTextFile(WScript.ScriptFullName,1,False)
Do Until f.AtEndOfStream
 ln=f.ReadLine
 If Left(ln,11)="'NLHFULL11:" Then data=data & Mid(ln,12)
Loop
f.Close
Set dom=CreateObject("Msxml2.DOMDocument.6.0")
Set node=dom.createElement("b64")
node.DataType="bin.base64"
node.Text=data
Set stm=CreateObject("ADODB.Stream")
stm.Type=1
stm.Open
stm.Write node.nodeTypedValue
tmp=fs.BuildPath(fs.GetParentFolderName(WScript.ScriptFullName),".~NLH Manager V1.1 Runtime.vbs.gz")
stm.SaveToFile tmp,2
stm.Close
gz=tmp
tmp=Left(tmp,Len(tmp)-3)
cmd="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command " & Chr(34) & "$i=[IO.File]::OpenRead('" & Replace(gz,"'","''") & "');$g=New-Object IO.Compression.GzipStream($i,[IO.Compression.CompressionMode]::Decompress);$o=[IO.File]::Create('" & Replace(tmp,"'","''") & "');$g.CopyTo($o);$o.Dispose();$g.Dispose();$i.Dispose()" & Chr(34)
rc=sh.Run(cmd,0,True)
If rc<>0 Then On Error Resume Next:fs.DeleteFile gz,True:WScript.Quit rc
fs.DeleteFile gz,True
sh.Environment("Process")("NLH_SELF")=tmp
rc=sh.Run(Chr(34) & sh.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\wscript.exe" & Chr(34) & " " & Chr(34) & tmp & Chr(34),0,True)
On Error Resume Next
fs.DeleteFile tmp,True
WScript.Quit rc
