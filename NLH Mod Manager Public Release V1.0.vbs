cmd=Chr(34) & ps & Chr(34) & " -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command " & Chr(34) & "$ErrorActionPreference='Stop';$n=[int]$env:NLH_B64_COUNT;$q=New-Object Text.StringBuilder;for($i=0;$i-lt$n;$i++){[void]$q.Append([Environment]::GetEnvironmentVariable(('NLH_B64_'+$i),'Process'));[Environment]::SetEnvironmentVariable(('NLH_B64_'+$i),$null,'Process')};[Environment]::SetEnvironmentVariable('NLH_B64_COUNT',$null,'Process');$c=[Convert]::FromBase64String($q.ToString());$h=[Security.Cryptography.SHA256]::Create();try{$x=([BitConverter]::ToString($h.ComputeHash($c))).Replace('-','');if($x-ne'57E560BFD21E593603424B27B7DFB8ACC1783A81AFEF8837C196B13454CC6FFE'){exit 71};$m=New-Object IO.MemoryStream(,$c);$g=New-Object IO.Compression.GzipStream($m,[IO.Compression.CompressionMode]::Decompress);$o=New-Object IO.MemoryStream;$g.CopyTo($o);$g.Dispose();$m.Dispose();$b=$o.ToArray();$o.Dispose();$y=([BitConverter]::ToString($h.ComputeHash($b))).Replace('-','');if($y-ne'5CD25A1F1E6F3B845FE899CED575C945DA462EEBC5603CE91AF9CDC9DD030942'){exit 72};$t=[Text.Encoding]::UTF8.GetString($b);$env:NLH_STANDALONE_CHILD='1';$env:NLH_FROSTY_PREFLIGHT_OK='1';$env:NLH_LAUNCH_HANDOFF=$null;$env:NLH_PROMOTION_GATE=$null;$env:NLH_STANDALONE_LOADER_HWND=$null;&([ScriptBlock]::Create($t))}finally{$h.Dispose()}" & Chr(34)
rc=sh.Run(cmd,0,True)
For i=0 To n-1
 sh.Environment("Process").Remove("NLH_B64_" & CStr(i))
Next
sh.Environment("Process").Remove("NLH_B64_COUNT")
WScript.Quit rc
