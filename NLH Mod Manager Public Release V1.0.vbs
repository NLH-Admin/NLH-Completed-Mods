Option Explicit
Dim sh,fs,f,ln,data,i,n,ps,cmd,rc
Set sh=CreateObject("WScript.Shell")
Set fs=CreateObject("Scripting.FileSystemObject")
data=""
Set f=fs.OpenTextFile(WScript.ScriptFullName,1,False)
Do Until f.AtEndOfStream
 ln=f.ReadLine
 If Left(ln,9)="'NLHGZ10:" Then data=data & Mid(ln,10)
Loop
f.Close
n=4
sh.Environment("Process")("NLH_B64_COUNT")=CStr(n)
For i=0 To n-1
 sh.Environment("Process")("NLH_B64_" & CStr(i))=Mid(data,(i*24000)+1,24000)
Next
