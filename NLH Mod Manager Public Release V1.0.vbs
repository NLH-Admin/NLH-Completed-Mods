cmd=Chr(34) & ps & Chr(34) & " -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command " & Chr(34) & "$ErrorActionPreference='Stop';$n=[int]$env:NLH_B64_COUNT;$q=New-Object Text.StringBuilder;for($i=0;$i-lt$n;$i++){[void]$q.Append([Environment]::GetEnvironmentVariable(('NLH_B64_'+$i),'Process'));[Environment]::SetEnvironmentVariable(('NLH_B64_'+$i),$null,'Process')};[Environment]::SetEnvironmentVariable('NLH_B64_COUNT',$null,'Process');$c=[Convert]::FromBase64String($q.ToString());$h=[Security.Cryptography.SHA256]::Create();try{$x=([BitConverter]::ToString($h.ComputeHash($c))).Replace('-','');if($x-ne'83BB72556817DAF3E55FB945692D602673961C0C676C92A3EF858345CF26F72B'){exit 71};$m=New-Object IO.MemoryStream(,$c);$g=New-Object IO.Compression.GzipStream($m,[IO.Compression.CompressionMode]::Decompress);$o=New-Object IO.MemoryStream;$g.CopyTo($o);$g.Dispose();$m.Dispose();$b=$o.ToArray();$o.Dispose();$y=([BitConverter]::ToString($h.ComputeHash($b))).Replace('-','');if($y-ne'ACE7CE5CBD3871867FD6FE78E5B7FB942A623AF175D6FF44CF09163CB3F56427'){exit 72};$t=[Text.Encoding]::UTF8.GetString($b);$env:NLH_STANDALONE_CHILD='1';$env:NLH_FROSTY_PREFLIGHT_OK='1';$env:NLH_LAUNCH_HANDOFF=$null;$env:NLH_PROMOTION_GATE=$null;$env:NLH_STANDALONE_LOADER_HWND=$null;&([ScriptBlock]::Create($t))}finally{$h.Dispose()}" & Chr(34)
rc=sh.Run(cmd,0,True)
For i=0 To n-1
 sh.Environment("Process").Remove("NLH_B64_" & CStr(i))
Next
sh.Environment("Process").Remove("NLH_B64_COUNT")
WScript.Quit rc
